# CRM PLUS Store — projeto central
# URL, Project Ref e publishable key ficam fixos no código por serem valores públicos.
# Mantenha apenas a chave secreta no ambiente do servidor quando necessária.
STORE_SUPABASE_SECRET_KEY=

# Stripe da CRM PLUS Store — somente backend/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago OAuth — contas conectadas dos clientes
# Configurar como Secrets das Edge Functions do Supabase central, nunca no navegador.
# Client ID pode usar o ID da aplicação Marketplace; Client Secret é obrigatório no fluxo OAuth.
MERCADO_PAGO_CONNECT_CLIENT_ID=
MERCADO_PAGO_CONNECT_CLIENT_SECRET=
MERCADO_PAGO_CONNECT_REDIRECT_URI=
# Base64url de exatamente 32 bytes aleatórios, usada para AES-GCM dos tokens OAuth.
MERCADO_PAGO_CONNECT_ENCRYPTION_KEY=

# Supabase operacional isolado
# Zeus e Artemis têm URL, Project Ref e publishable key fixos no código.
# Na Vercel, mantenha SOMENTE a secret/service-role key de cada app.
ZEUS_SUPABASE_SECRET_KEY=
ARTEMIS_SUPABASE_SECRET_KEY=

# Demais aplicativos — configurar quando forem conectados a bancos próprios.
KRONOS_SUPABASE_URL=
KRONOS_SUPABASE_PUBLISHABLE_KEY=
KRONOS_SUPABASE_SECRET_KEY=

ATHENA_ORCAMENTOS_SUPABASE_URL=
ATHENA_ORCAMENTOS_SUPABASE_PUBLISHABLE_KEY=
ATHENA_ORCAMENTOS_SUPABASE_SECRET_KEY=

ATHENA_PESQUISA_SUPABASE_URL=
ATHENA_PESQUISA_SUPABASE_PUBLISHABLE_KEY=
ATHENA_PESQUISA_SUPABASE_SECRET_KEY=

# Cloudflare R2 isolado por aplicativo
ZEUS_R2_ACCOUNT_ID=
ZEUS_R2_ACCESS_KEY_ID=
ZEUS_R2_SECRET_ACCESS_KEY=
ZEUS_R2_BUCKET=

ARTEMIS_R2_ACCOUNT_ID=
ARTEMIS_R2_ACCESS_KEY_ID=
ARTEMIS_R2_SECRET_ACCESS_KEY=
ARTEMIS_R2_BUCKET=

# IA isolada por aplicativo
ZEUS_GROQ_API_KEY=
ARTEMIS_GROQ_API_KEY=
